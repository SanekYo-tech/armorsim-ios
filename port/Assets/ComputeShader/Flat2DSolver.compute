// Counts cross-body neighbours of every particle within 2H (rate pass).
[numthreads(256, 1, 1)]
void KCrossFlagV(uint3 gl_GlobalInvocationID : SV_DispatchThreadID)
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= (uint)_N)
        return;

    if (id == 0u)
    {
        uint orig;
        InterlockedAdd(_TbProbe[3], 1u, orig);
    }

    float2 x = _PosR[id];
    uint body = _BodyR[id];

    int ix = (int)floor((x.x - _OriginX) / _CellSize);
    int iy = (int)floor((x.y - _OriginY) / _CellSize);

    float r2 = (_H + _H) * (_H + _H);
    uint count = 0u;

    for (int cy = -1; cy <= 1; ++cy)
    {
        int gy = iy + cy;
        if (gy < 0 || gy >= _GridH)
            continue;
        for (int cx = -1; cx <= 1; ++cx)
        {
            int gx = ix + cx;
            if (gx < 0 || gx >= _GridW)
                continue;

            uint cell = (uint)(gy * _GridW + gx);
            uint first = _CellStartR[cell];
            uint last = first + _CellCountR[cell];

            for (uint k = first; k < last; ++k)
            {
                uint j = _OrderR[k];
                if (j == id)
                    continue;
                if (_BodyR[j] == body)
                    continue;

                float2 d = x - _PosR[j];
                float d2 = dot(d, d);
                if (d2 >= r2 || d2 < 1e-24f)
                    continue;

                ++count;
            }
        }
    }

    _CrossPairsV[id] = count;
}

