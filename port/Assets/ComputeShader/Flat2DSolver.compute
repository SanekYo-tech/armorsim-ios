// ---------------------------------------------------------------------------
// 004  KScanBlockSums  —  exclusive scan of the block sums (single thread)
// ---------------------------------------------------------------------------
[numthreads(1, 1, 1)]
void KScanBlockSums()
{
    float4 r0;
    r0 = float4(0.0f.xx.x, 0.0f.xx.y, r0.z, r0.w);
    for (;;)
    {
        r0.z = asfloat((asuint(r0.y) >= asuint(_NumBlocks)) ? 4294967295u : 0u);
        if (asuint(r0.z) != 0u)
        {
            break;
        }
        r0.z = asfloat(_BlockSums[asint(r0.y)]);
        _BlockSums[asint(r0.y)] = asuint(r0.x);
        r0.x = asfloat(asint(r0.z) + asint(r0.x));
        r0.y = asfloat(asint(r0.y) + 1);
        continue;
    }
}

// ---------------------------------------------------------------------------
// 005  KScanApply  —  add block offset to every cell prefix sum
